HOST=0.0.0.0
PORT=8000
# Claude 전용 최대 토큰 설정. OpenAI Responses API 및 Gemini API에는 사용하지 않음.
MAX_TOKENS=4096
# JWT 서명용 시크릿 키 (랜덤 문자열 권장)
SECRET_KEY=your-secret-key-here
# SMTP 이메일 발송 설정 (사용자 보안키 발송용)
# 미설정 시 이메일 발송 생략, 콘솔에 보안키 출력
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
