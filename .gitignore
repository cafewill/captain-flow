# =========================
# Captain FLOW - .gitignore
# =========================

# --- OS / Editor ---
.DS_Store
Thumbs.db
__MACOSX/
.idea/
.vscode/
*.swp
*.swo

# --- Python ---
__pycache__/
*.py[cod]
*.pyd
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual env ---
.venv/
venv/
ENV/
env/

# --- Env / Secrets ---
.env
.env.*
!.env.example

# --- Runtime data / logs (DO NOT COMMIT) ---
data/settings.json
data/security_events.jsonl
data/*.jsonl
data/*.log
logs/
*.log

# If you want to keep the data/ directory in Git, add: data/.gitkeep

# --- Node (optional future expansion) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
